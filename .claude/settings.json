{
  "permissions": {
    "deny": [
      "Write(AI Automation/**)",
      "Edit(AI Automation/**)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/zcat-validate.py\"",
            "timeout": 30,
            "statusMessage": "Validating page against zcat design rules"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/zcat-gate.py\"",
            "timeout": 240,
            "statusMessage": "Rendering screens and checking design proof"
          }
        ]
      }
    ]
  }
}
